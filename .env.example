# Telegram
TELEGRAM_BOT_TOKEN=123456:telegram_bot_token_from_BotFather
TELEGRAM_ALLOWED_CHAT_ID=123456789
# Longer responses are sent as a complete UTF-8 Markdown document.
TELEGRAM_MESSAGE_MAX_LENGTH=3900

# Claude Code CLI must already be installed for the VPS user.
CLAUDE_COMMAND=claude
CLAUDE_WORKDIR=/home/agento
CLAUDE_TIMEOUT_SECONDS=900
CLAUDE_MAX_OUTPUT_CHARS=30000
# default = no --model / --effort flag; Claude Code uses its own configuration.
CLAUDE_MODEL=default
CLAUDE_EFFORT=default

# Access modes exposed through /mode:
# read-only    = reads and read-only shell commands; everything else is denied
# workspace    = file edits inside CLAUDE_WORKDIR + shell commands in the Bash sandbox
#                (writes only in CLAUDE_WORKDIR, no network; needs bubblewrap and socat)
# full-access  = --permission-mode bypassPermissions (no permission checks)
CLAUDE_ACCESS_MODE=full-access

CLAUDE_SETTINGS_FILE=./agento-settings.properties
CLAUDE_SESSION_FILE=./agento-session.properties

# Values offered in the Telegram menus. "default" means "do not pass the flag".
# Models: aliases or full model names accepted by `claude --model`.
CLAUDE_ALLOWED_MODELS=default,opus,sonnet,haiku,fable
# Efforts: default, low, medium, high, xhigh, max.
CLAUDE_ALLOWED_EFFORTS=default,low,medium,high,xhigh,max
CLAUDE_ALLOWED_ACCESS_MODES=read-only,workspace,full-access

# Read by the Claude Code CLI itself (inherited by the claude process).
# Token from `claude setup-token` (Claude subscription, valid for one year).
CLAUDE_CODE_OAUTH_TOKEN=
# Hide credentials from the shell commands Claude runs.
CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1
# Update Claude Code manually with `claude update`.
DISABLE_AUTOUPDATER=1
# Optional: Claude Code configuration and session directory (default ~/.claude).
# CLAUDE_CONFIG_DIR=
# Never set ANTHROPIC_API_KEY for the bot: in -p mode it always wins over the subscription token.
