# Telegram
TELEGRAM_BOT_TOKEN=123456:telegram_bot_token_from_BotFather
TELEGRAM_ALLOWED_CHAT_ID=123456789

# Codex CLI must already be installed and authenticated for the VPS user.
CODEX_COMMAND=codex
CODEX_WORKDIR=/home/agento
CODEX_TIMEOUT_SECONDS=900
CODEX_MAX_OUTPUT_CHARS=30000
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=medium

# Access modes exposed through /mode:
# read-only    = Codex can inspect only
# workspace    = Codex can write inside CODEX_WORKDIR
# full-access  = Codex gets --dangerously-bypass-approvals-and-sandbox
CODEX_ACCESS_MODE=full-access

CODEX_SKIP_GIT_REPO_CHECK=true
CODEX_SETTINGS_FILE=./agento-settings.properties

CODEX_ALLOWED_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex
CODEX_ALLOWED_REASONING_EFFORTS=low,medium,high,xhigh
CODEX_ALLOWED_ACCESS_MODES=read-only,workspace,full-access
